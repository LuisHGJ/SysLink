# ─── Banco de Dados ─────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=change-me-secure-password
DB_NAME=syslink
DB_PORT=5432

# ─── Backend (FastAPI) ──────────────────────────────────────────
SECRET_KEY=your-256-bit-secret-key-change-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=

# ─── IA / OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning:free
AI_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free

# ─── Apify (scraping Instagram) ─────────────────────────────────
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/instagram-search-scraper

# ─── Tavily (busca de perfis do Instagram, roda em paralelo à Apify) ──
# Chave em tvly-… (tavily.com). Vazia → Escavador busca só com a Apify.
TAVILY_API_KEY=

# ─── Cota do Escavador (perfis escavados por usuário por dia) ────
# Janela de calendário na meia-noite BRT. 0 = cota desativada.
EXCAVATE_DAILY_PROFILE_LIMIT=50

# ─── Resend (envio de e-mails — verificação e recuperação de senha) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SysLink <no-reply@seudominio.com>

# Base dos links enviados nos e-mails (confirmação / redefinição)
FRONTEND_URL=http://localhost:3000

# ─── Rate limit (janela deslizante de 60s, em memória) ───────────
# Por IP nos endpoints públicos de auth (0 = desativado)
RATE_LIMIT_AUTH_PER_MINUTE=5
# Por user_id nas rotas autenticadas (leads/escavador; 0 = desativado)
RATE_LIMIT_USER_PER_MINUTE=100
# true SÓ atrás de proxy confiável (lê X-Forwarded-For); sem proxy,
# deixe false — senão qualquer cliente forja o IP
TRUST_PROXY_HEADERS=false

# ─── Frontend (Next.js) ─────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000
